# LibSQL / Turso. Local default is a file URL (no native better-sqlite3).
# For Turso Cloud use libsql://... and set DATABASE_AUTH_TOKEN.
# Never commit real tokens or production passwords.
DATABASE_URL=file:./data/spoke.db
DATABASE_AUTH_TOKEN=

# Public origin used in emails and copied links. Leave blank to use the
# incoming request host (typical for `npm run dev`). On Vercel set this to
# your production URL, e.g. https://spokersvp.vercel.app
APP_URL=http://localhost:3000

# Email transport. Default outbox: messages are stored on /host/outbox and logged.
# Nothing is sent. To send with Resend later, set all three of these (never commit the key):
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   RESEND_FROM=Marin Villages <rsvp@your-verified-domain>
# SMTP is not connected. EMAIL_PROVIDER=smtp expects SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_PASS, and SMTP_FROM, and keeps the message in the Outbox
# until a transport is added in src/lib/mailer.ts.
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
RESEND_FROM=SpokeRSVP <noreply@example.com>

# Shared secret for GET/POST /api/reminders (Vercel Cron + manual cron).
# Leave empty to keep that HTTP endpoint off; use `npm run reminders` locally.
# On Vercel, also set CRON_SECRET to the same value so Cron sends the Bearer header.
REMINDER_SECRET=

# SMS is not implemented in this MVP (TODO: Twilio or similar).
