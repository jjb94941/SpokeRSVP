# Local SQLite database file (created on first seed / first run)
DATABASE_PATH=./data/spoke.db

# Public origin used in emails and copied links. Leave blank to use the
# incoming request host (typical for `npm run dev`).
APP_URL=http://localhost:3000

# Optional. When set, confirmation / waitlist / reminder emails send via Resend.
# When empty, SpokeRSVP logs the message and (for magic links) shows the URL
# on screen. Never commit a real key.
RESEND_API_KEY=
RESEND_FROM=SpokeRSVP <noreply@example.com>

# Optional shared secret for POST /api/reminders (cron). Leave empty to
# allow only the local `npm run reminders` script.
REMINDER_SECRET=

# SMS is not implemented in this MVP (TODO: Twilio or similar).
